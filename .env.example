PYTHONPATH=src
CONFIG_PATH=configs/example.yaml

# Local-only HTTP ingress. Use HTTPS and secure cookies before public deployment.
APP_DOMAIN=localhost
APP_ORIGIN=http://localhost
ZITADEL_DOMAIN=zitadel.localhost
ZITADEL_VERSION=v4.16.0
# Generate secrets as described in docs/authentication.md; never commit .env.
ZITADEL_MASTERKEY=
ZITADEL_DB_PASSWORD=
ZITADEL_DB_ADMIN_PASSWORD=
ZITADEL_ADMIN_PASSWORD=
ZITADEL_LOGIN_COOKIE_SECRET=
ZITADEL_LOGIN_PAT_EXPIRATION=2027-10-01T00:00:00Z
OAUTH2_PROXY_COOKIE_SECRET=
# Set after creating the Web / Code / BASIC client in Zitadel.
OAUTH2_PROXY_CLIENT_ID=
OAUTH2_PROXY_CLIENT_SECRET=
OIDC__USERINFO_URL=http://zitadel.localhost/oidc/v1/userinfo

# Logger
LEVEL=DEBUG
FORMAT=json

# Postgres
DB_HOST_PORT=5433
DB_USER=postgres
DB_PASS=password
DB_NAME=mydb

# RabbitMQ
RABBIT_HOST_PORT=5672
RABBIT_MANAGEMENT_PORT=15672
RABBIT_USER=admin
RABBIT_PASS=password

# MinIO
MINIO_HOST_PORT=9000
MINIO_CONSOLE_PORT=9001
S3__ACCESS_KEY=minioadmin
S3__SECRET_KEY=minioadmin

# Qdrant
QDRANT_HOST_PORT=6333
QDRANT_GRPC_HOST_PORT=6334
QDRANT__SECRET_KEY=secret-key

# LLM
API_KEY=sk-or-vv-secret
LLM__BASE_URL=https://openrouter.ai/api/v1
LLM__MODEL=openrouter/free
LLM__EMBED_MODEL=openai/text-embedding-ada-002
