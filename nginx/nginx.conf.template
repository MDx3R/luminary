worker_processes auto;
error_log /var/log/nginx/error.log notice;

events {
    worker_connections 1024;
}

http {
    server_tokens off;
    resolver 127.0.0.11 valid=10s ipv6=off;
    gzip on;
    gzip_types application/json application/javascript text/plain text/css;
    gzip_min_length 1024;
    limit_req_zone $binary_remote_addr zone=api:10m rate=30r/s;
    keepalive_timeout 65;
    client_max_body_size 50m;

    # Never record OAuth callback codes or bearer credentials in access logs.
    log_format safe '$remote_addr "$request_method $uri $server_protocol" $status';
    access_log /var/log/nginx/access.log safe;

    server {
        listen 80 default_server;
        server_name _;
        return 404;
    }

    server {
        listen 80;
        server_name ${APP_DOMAIN};
        set $app_upstream http://app:8000;
        set $oauth_upstream http://oauth2-proxy:4180;

        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
        proxy_buffering off;
        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options DENY always;

        location = /oauth2/auth {
            internal;
            proxy_pass $oauth_upstream/oauth2/auth;
            proxy_pass_request_body off;
            proxy_set_header Content-Length "";
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Forwarded-Host $host;
            proxy_set_header X-Original-URL ${APP_ORIGIN}$request_uri;
            proxy_set_header Authorization "";
            proxy_set_header X-User-Id "";
            proxy_set_header X-Username "";
        }

        location /oauth2/ {
            proxy_pass $oauth_upstream;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Auth-Request-Redirect ${APP_ORIGIN}/users/me;
            proxy_set_header X-Forwarded-Host $host;
            proxy_set_header Authorization "";
            proxy_set_header X-User-Id "";
            proxy_set_header X-Username "";
        }

        location = /api/v1/assistants/public {
            limit_except GET { deny all; }
            proxy_pass $app_upstream;
            proxy_set_header Host $http_host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $remote_addr;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-User-Id "";
            proxy_set_header X-Username "";
            proxy_set_header Authorization "";
        }

        location / {
            limit_req zone=api burst=60 nodelay;
            auth_request /oauth2/auth;
            auth_request_set $user $upstream_http_x_auth_request_user;
            auth_request_set $username $upstream_http_x_auth_request_preferred_username;
            auth_request_set $token $upstream_http_x_auth_request_access_token;
            proxy_set_header Host $http_host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $remote_addr;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-User-Id $user;
            proxy_set_header X-Username $username;
            proxy_set_header Authorization "Bearer $token";
            proxy_pass $app_upstream;
        }
    }

    server {
        listen 80;
        http2 on;
        server_name ${ZITADEL_DOMAIN};
        set $zitadel_upstream grpc://zitadel-api:8080;
        set $login_upstream http://zitadel-login:3000;

        location = / { return 302 /ui/v2/login/; }

        location /ui/v2/login {
            proxy_pass $login_upstream;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Forwarded-For $remote_addr;
        }

        location / {
            grpc_pass $zitadel_upstream;
            grpc_set_header Host $host;
            grpc_set_header X-Forwarded-Proto $scheme;
            grpc_set_header X-Forwarded-For $remote_addr;
        }
    }
}
